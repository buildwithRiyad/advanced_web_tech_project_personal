# Hotel Management System - Backend Configuration
# Copy this file to .env and update values as needed

# Application
PORT=3001
NODE_ENV=development

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=hotel_db

# JWT
JWT_SECRET=secretKey
JWT_EXPIRY=1h

# Pusher realtime notifications
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=2097152

# CORS
CORS_ORIGIN=http://localhost:3000,http://192.168.0.101:3000
